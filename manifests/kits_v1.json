        "stdlib_only": true
      },
      "allowed_paths": [
        "src/service_main.py",
        "src/service_core.py",
        "src/cli.py",
        "src/canonical_json_v1.py",
        "tests/test_smoke.py",
        "config.example.json",
        ".gitignore"
      ],
      "requirements_default": {
        "summary": "Create a minimal Windows service-style scaffold (stdlib-only). Provide CLI commands: ping/selftest/version. Service core must be deterministic and testable without network."
      }
    },
    {
      "kit_id": "kit_web_dashboard_v0",
      "default_product_id": "web_dashboard_v0",
