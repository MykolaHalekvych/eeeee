      "allowed_paths": [
        "src/app.py",
        "src/cli.py",
        "src/canonical_json_v1.py",
        "tests/test_smoke.py",
        "config.example.json",
        ".gitignore"
      ],
      "requirements_default": {
        "summary": "Create a minimal dashboard scaffold (stdlib-only). Provide CLI commands: ping/selftest/version. The dashboard entrypoint is src/app.py (placeholder)."
      }
    },
    {
