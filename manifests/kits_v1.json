        "tests/test_manifest_v1.py",
        "tests/test_smoke.py",
        "config.example.json",
        ".gitignore"
      ],
      "requirements_default": {
        "summary": "Extend existing CLI: keep hello/version/hash; ensure ping/selftest/manifest validate exist; stdlib-only; deterministic selftest that works inside PyInstaller EXE."
      }
    },
    {
      "kit_id": "kit_windows_service_v0",
